# Copy to .env.production and fill in. Never commit .env.production.

# The public domain name that points at this server (an A/AAAA DNS record). Caddy gets a certificate for it.
# For a local trial use: DOMAIN=localhost  (Caddy then uses its own local certificate)
DOMAIN=cards.example.com

# Pick a long random password, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Optional
# TURN_TIMEOUT_SECONDS=120
# DISCONNECT_GRACE_SECONDS=60

# Copy to .env (never commit .env)
DATABASE_URL=postgres://cardgame:cardgame@localhost:5432/cardgame
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Optional tuning (defaults shown)
# SESSION_TTL_DAYS=30
# SCRYPT_LOG_N=17        # password hashing cost (2^N); raise over time, lower only in tests
# RATE_LIMIT_MAX=10      # login/register attempts per window, per IP
# RATE_LIMIT_WINDOW=1 minute
# TURN_TIMEOUT_SECONDS=120          # time to finish a turn before losing
# DISCONNECT_GRACE_SECONDS=60       # time to reconnect to a running game
# WAITING_GAME_TTL_MINUTES=30       # unjoined games are cancelled after this
# ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; browsers from other origins cannot open the WebSocket
# Production (set by docker-compose.prod.yml; see docs/DEPLOY.md):
# TRUST_PROXY=true                  # behind Caddy/nginx
# WEB_DIST=/app/web                 # serve the built web client from this folder
# MIGRATIONS_DIR=/app/migrations

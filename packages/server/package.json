{
  "name": "@cardgame/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file=.env src/db/seed-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "@cardgame/engine": "workspace:*",
    "@cardgame/protocol": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.1",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
